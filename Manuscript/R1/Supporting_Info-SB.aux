\@writefile{lofig}{\contentsline {suppfigure}{\numberline {13}{\ignorespaces Impact of accounting for the revision of the dinomyid fauna of the Ituzaingó Formation (Entre Ríos Province, Argentina) on the estimation of the temporal dynamics of chinchilloid extinction rate (\citeproc {ref-rasia2026}{Rasia 2026}). (\textbf  {A}) Lifespans of species making up the `Mesopotamiense' fauna (Ituzaingó Fm.) before (\emph  {left}) and after (\emph  {right}) the taxonomic revision. Removed taxa were coloured in red (five taxa lost). (\textbf  {B}) Chinchilloid extinction rates estimated from our temporal occurrence database before (\emph  {left}) and after (\emph  {right}) incorporating the aforementioned revision. The histogram in background shows the frequency of rate shift estimated by the rjMCMC model, that is, for a given time frame (by default set to 1My), how likely it is to consider that the reconstructed extinction rate experienced a shift. The dashed lines labelled (*) and (***) respectively indicate significant and strongly supported rate shift.}}{12}{suppfigure.13}\protected@file@percent }
\newlabel{fig-RasiaEffect}{{13}{12}{Impact of accounting for the revision of the dinomyid fauna of the Ituzaingó Formation (Entre Ríos Province, Argentina) on the estimation of the temporal dynamics of chinchilloid extinction rate (\citeproc {ref-rasia2026}{Rasia 2026}). (\textbf {A}) Lifespans of species making up the `Mesopotamiense' fauna (Ituzaingó Fm.) before (\emph {left}) and after (\emph {right}) the taxonomic revision. Removed taxa were coloured in red (five taxa lost). (\textbf {B}) Chinchilloid extinction rates estimated from our temporal occurrence database before (\emph {left}) and after (\emph {right}) incorporating the aforementioned revision. The histogram in background shows the frequency of rate shift estimated by the rjMCMC model, that is, for a given time frame (by default set to 1My), how likely it is to consider that the reconstructed extinction rate experienced a shift. The dashed lines labelled (*) and (***) respectively indicate significant and strongly supported rate shift}{suppfigure.13}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {14}{\ignorespaces Posterior estimate of the shape parameter of the Weibull distribution for the ADE analyses of the `Early' (\textgreater {} 6 Ma) and `Late' (\textless {} 6 Ma) occurrence datasets, each with constant extinction rate (Figure~S\ref {fig-FreqRateShift}). 2.5\%, 50\% and 97.5\% quantiles are indicated in the distribution of each parameter by black horizontal lines, respectively from bottom to top.}}{13}{suppfigure.14}\protected@file@percent }
\newlabel{fig-violinADE}{{14}{13}{Posterior estimate of the shape parameter of the Weibull distribution for the ADE analyses of the `Early' (\textgreater {} 6 Ma) and `Late' (\textless {} 6 Ma) occurrence datasets, each with constant extinction rate (Figure~S\ref {fig-FreqRateShift}). 2.5\%, 50\% and 97.5\% quantiles are indicated in the distribution of each parameter by black horizontal lines, respectively from bottom to top}{suppfigure.14}{}}
