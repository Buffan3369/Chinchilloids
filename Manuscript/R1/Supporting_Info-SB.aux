\newlabel{fig-RTTperBM}{{15}{13}{Speciation (\textbf {A}) and extinction (\textbf {B}) rates through time per body mass class as inferred by the rjMCMC model}{suppfigure.15}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {16}{\ignorespaces Frequency of speciation and extinction rate shifts per body size class as estimated by the analysis of our species-level chinchilloid occurrence dataset with the rjMCMC model. Dashed horizontal lines indicate 2 * log(Bayes factor) of 2 and 6, respectively suggesting significant and strongly-supported rate shifts.}}{14}{suppfigure.16}\protected@file@percent }
\newlabel{fig-FreqRateShiftBM}{{16}{14}{Frequency of speciation and extinction rate shifts per body size class as estimated by the analysis of our species-level chinchilloid occurrence dataset with the rjMCMC model. Dashed horizontal lines indicate 2 * log(Bayes factor) of 2 and 6, respectively suggesting significant and strongly-supported rate shifts}{suppfigure.16}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {17}{\ignorespaces Marginal chinchilloid speciation (blue) and extinction (red) rates through time as estimated by our BDNN analyses of the datasets with random trait (\emph  {i}.\emph  {e}., body mass and/or hypsodonty index) imputation for taxa with missing trait reconstruction (\(n=11\)). Caribbean taxa were excluded. Full lines show median rate estimates and ribbons their associated 95\% Highest Posterior Density (HPD) interval, assessed acrossed the 10 independent BDNN runs randomising fossil ages under a uniform law made for each trait imputation. This panel only depicts the rates through time from replicate 1 to 5.}}{15}{suppfigure.17}\protected@file@percent }
\newlabel{fig-RTT_BDNN_NoCar15}{{17}{15}{Marginal chinchilloid speciation (blue) and extinction (red) rates through time as estimated by our BDNN analyses of the datasets with random trait (\emph {i}.\emph {e}., body mass and/or hypsodonty index) imputation for taxa with missing trait reconstruction (\(n=11\)). Caribbean taxa were excluded. Full lines show median rate estimates and ribbons their associated 95\% Highest Posterior Density (HPD) interval, assessed acrossed the 10 independent BDNN runs randomising fossil ages under a uniform law made for each trait imputation. This panel only depicts the rates through time from replicate 1 to 5}{suppfigure.17}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {18}{\ignorespaces Marginal chinchilloid speciation (blue) and extinction (red) rates through time as estimated by our BDNN analyses of the datasets with random trait (\emph  {i}.\emph  {e}., body mass and/or hypsodonty index) imputation for taxa with missing trait reconstruction (\(n=11\)). Caribbean taxa were excluded. Full lines show median rate estimates and ribbons their associated 95\% Highest Posterior Density (HPD) interval, assessed acrossed the 10 independent BDNN runs randomising fossil ages under a uniform law made for each trait imputation. This panel only depicts the rates through time from replicate 1 to 5.}}{16}{suppfigure.18}\protected@file@percent }
\newlabel{fig-RTT_BDNN_NoCar610}{{18}{16}{Marginal chinchilloid speciation (blue) and extinction (red) rates through time as estimated by our BDNN analyses of the datasets with random trait (\emph {i}.\emph {e}., body mass and/or hypsodonty index) imputation for taxa with missing trait reconstruction (\(n=11\)). Caribbean taxa were excluded. Full lines show median rate estimates and ribbons their associated 95\% Highest Posterior Density (HPD) interval, assessed acrossed the 10 independent BDNN runs randomising fossil ages under a uniform law made for each trait imputation. This panel only depicts the rates through time from replicate 1 to 5}{suppfigure.18}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {19}{\ignorespaces Training and validation loss across training epochs for a DeepDive network comprising two LSTM units (64 and 32 nodes) connected to two dense layers (64 and 32 nodes) before the output layer. The red vertical line indicates the ``early stopping point'', \emph  {i}.\emph  {e}., when the validation loss starts increasing, indicative of overfitting. It determines the optimal value of number of iterations, at which we derive the training and validation loss values depicted between parenthesis.}}{17}{suppfigure.19}\protected@file@percent }
\newlabel{fig-ddHistPlotL2D2}{{19}{17}{Training and validation loss across training epochs for a DeepDive network comprising two LSTM units (64 and 32 nodes) connected to two dense layers (64 and 32 nodes) before the output layer. The red vertical line indicates the ``early stopping point'', \emph {i}.\emph {e}., when the validation loss starts increasing, indicative of overfitting. It determines the optimal value of number of iterations, at which we derive the training and validation loss values depicted between parenthesis}{suppfigure.19}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {20}{\ignorespaces Training and validation loss across training epochs for a DeepDive network comprising three LSTM units (128, 64 and 32 nodes) connected to two dense layers (64 and 32 nodes) before the output layer. The red vertical line indicates the ``early stopping point'', \emph  {i}.\emph  {e}., when the validation loss starts increasing, indicative of overfitting. It determines the optimal value of number of iterations, at which we derive the training and validation loss values depicted between parenthesis.}}{17}{suppfigure.20}\protected@file@percent }
\newlabel{fig-ddHistPlotL3D2}{{20}{17}{Training and validation loss across training epochs for a DeepDive network comprising three LSTM units (128, 64 and 32 nodes) connected to two dense layers (64 and 32 nodes) before the output layer. The red vertical line indicates the ``early stopping point'', \emph {i}.\emph {e}., when the validation loss starts increasing, indicative of overfitting. It determines the optimal value of number of iterations, at which we derive the training and validation loss values depicted between parenthesis}{suppfigure.20}{}}
