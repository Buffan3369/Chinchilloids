\@writefile{lofig}{\contentsline {suppfigure}{\numberline {6}{\ignorespaces Convergence of the PyRate runs (rjMCMC algorithm) for the analysis of the species-level temporal occurrence database. (\textbf  {A}) shows the ESS of the model posterior probability for all the 20 replicates we ran. ESS greater than 200 (first-scale indicator of a run that converged, \(n=20\) in that case) are displayed in green. The yellow and red line respectively depict ESS=200 and ESS=100. The proportion of origination and extinction times (resp. \(T_S\) and \(T_E\)) that converged (i.e., with \(ESS > 200\)) are shown in (\textbf  {B}), for each of our 20 replicates. (\textbf  {C}) shows the posterior estimates of the mean root age of our group, together with their lower and upper boundaries of the 95\% HPD interval, across the 20 replicates.}}{8}{suppfigure.6}\protected@file@percent }
\newlabel{fig-ESSplot}{{6}{8}{Convergence of the PyRate runs (rjMCMC algorithm) for the analysis of the species-level temporal occurrence database. (\textbf {A}) shows the ESS of the model posterior probability for all the 20 replicates we ran. ESS greater than 200 (first-scale indicator of a run that converged, \(n=20\) in that case) are displayed in green. The yellow and red line respectively depict ESS=200 and ESS=100. The proportion of origination and extinction times (resp. \(T_S\) and \(T_E\)) that converged (i.e., with \(ESS > 200\)) are shown in (\textbf {B}), for each of our 20 replicates. (\textbf {C}) shows the posterior estimates of the mean root age of our group, together with their lower and upper boundaries of the 95\% HPD interval, across the 20 replicates}{suppfigure.6}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {7}{\ignorespaces Histogram showing the frequency of speciation (\textbf  {A}) and extinction (\textbf  {B}) rate shifts in our species-level chinchilloid dataset estimated by PyRate (rjMCMC algorithm). This quantity indicates, within 1My time bins, the support given to a model with rate shift compared to a model with constant rates. The two dashed lines respectively labelled \(2log(BF)>2\) and \(2log(BF)>6\) respectively indicate significant and strongly supported rate shift.}}{8}{suppfigure.7}\protected@file@percent }
\newlabel{fig-FreqRateShift}{{7}{8}{Histogram showing the frequency of speciation (\textbf {A}) and extinction (\textbf {B}) rate shifts in our species-level chinchilloid dataset estimated by PyRate (rjMCMC algorithm). This quantity indicates, within 1My time bins, the support given to a model with rate shift compared to a model with constant rates. The two dashed lines respectively labelled \(2log(BF)>2\) and \(2log(BF)>6\) respectively indicate significant and strongly supported rate shift}{suppfigure.7}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {8}{\ignorespaces Bayesian reconstruction of the longevities of the 124 chinchilloid species considered in our dataset. Each segment depicts the longevity of a given species, that is, the interval between species' speciation and extinction times averaged across PyRate runs that achieved convergence. Segments and taxonomic names were coloured according to the crown height category to which species were assigned. The histogram at the centre of the plot shows the number of species within each crown height class. Depending on the phylogenetic hypothesis considered Rasia et al. (\citeproc {ref-rasia_comprehensive_2021}{2021}), taxa labelled a `Stem Chinchilloidea' may either be considered as actual stem, or as \emph  {Familia incertae sedis}. The first four silhouettes (from top to bottom) are from Phylopic (credits available in Table S3). The last two silhouettes (\emph  {Elasmodontomys obliquus} and \emph  {Borikenomys praecursor}) were designed by L.M. for a previous work (\citeproc {ref-marivaux_early_2020}{Marivaux et al. 2020}).}}{9}{suppfigure.8}\protected@file@percent }
\newlabel{fig-LifespanHypso}{{8}{9}{Bayesian reconstruction of the longevities of the 124 chinchilloid species considered in our dataset. Each segment depicts the longevity of a given species, that is, the interval between species' speciation and extinction times averaged across PyRate runs that achieved convergence. Segments and taxonomic names were coloured according to the crown height category to which species were assigned. The histogram at the centre of the plot shows the number of species within each crown height class. Depending on the phylogenetic hypothesis considered Rasia et al. (\citeproc {ref-rasia_comprehensive_2021}{2021}), taxa labelled a `Stem Chinchilloidea' may either be considered as actual stem, or as \emph {Familia incertae sedis}. The first four silhouettes (from top to bottom) are from Phylopic (credits available in Table S3). The last two silhouettes (\emph {Elasmodontomys obliquus} and \emph {Borikenomys praecursor}) were designed by L.M. for a previous work (\citeproc {ref-marivaux_early_2020}{Marivaux et al. 2020})}{suppfigure.8}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {9}{\ignorespaces Joint estimation of origination (blue) and extinction (red) rates (\textbf  {A}), net diversification rate (\textbf  {B}), diversity through time (\textbf  {C}) and preservation rates (\textbf  {D}) from our species-level chinchilloid database made my PyRate (rjMCMC algorithm) after removing singletons.}}{10}{suppfigure.9}\protected@file@percent }
\newlabel{fig-RecapSingletonRTT}{{9}{10}{Joint estimation of origination (blue) and extinction (red) rates (\textbf {A}), net diversification rate (\textbf {B}), diversity through time (\textbf {C}) and preservation rates (\textbf {D}) from our species-level chinchilloid database made my PyRate (rjMCMC algorithm) after removing singletons}{suppfigure.9}{}}
