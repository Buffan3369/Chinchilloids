\@writefile{lofig}{\contentsline {suppfigure}{\numberline {2}{\ignorespaces Impact of the sampling scheme of extant species lacking fossil record on upstream macroevolutionary inferences with PyRate (rjMCMC algorithm). (\textbf  {A}, \textbf  {D}, \textbf  {G}) show speciation rate, extinction rate and sampled diversity estimated from a database only encompassing fossil taxa. In (\textbf  {B}, \textbf  {E}, \textbf  {H}), extant taxa were included by means of an occurrence with origination and extinction ages (\(T_e\) and \(T_e\)) set to 0 Ma (\emph  {i}.\emph  {e}., `biased incorporation'). In (\textbf  {C}, \textbf  {F}, \textbf  {I}), extant taxa were included or with our newly-introduced pipeline relying on ages extracted from dated phylogenies. Full lines indicate median rate estimation (blue for speciation, \textbf  {A}--\textbf  {C}, red for extinction, \textbf  {D}--\textbf  {F}), and ribbons their associated 95\% HPD interval. Grey histograms in the background depict the frequency of rate shift per 1-My time bins (\textbf  {A}--\textbf  {F}). The two horizontal lines labelled * and *** respectively indicate significant and strongly supported rate shift (\textbf  {A}--\textbf  {F}).}}{5}{suppfigure.2}\protected@file@percent }
\newlabel{fig-EffectSamplingRTT}{{2}{5}{Impact of the sampling scheme of extant species lacking fossil record on upstream macroevolutionary inferences with PyRate (rjMCMC algorithm). (\textbf {A}, \textbf {D}, \textbf {G}) show speciation rate, extinction rate and sampled diversity estimated from a database only encompassing fossil taxa. In (\textbf {B}, \textbf {E}, \textbf {H}), extant taxa were included by means of an occurrence with origination and extinction ages (\(T_e\) and \(T_e\)) set to 0 Ma (\emph {i}.\emph {e}., `biased incorporation'). In (\textbf {C}, \textbf {F}, \textbf {I}), extant taxa were included or with our newly-introduced pipeline relying on ages extracted from dated phylogenies. Full lines indicate median rate estimation (blue for speciation, \textbf {A}--\textbf {C}, red for extinction, \textbf {D}--\textbf {F}), and ribbons their associated 95\% HPD interval. Grey histograms in the background depict the frequency of rate shift per 1-My time bins (\textbf {A}--\textbf {F}). The two horizontal lines labelled * and *** respectively indicate significant and strongly supported rate shift (\textbf {A}--\textbf {F})}{suppfigure.2}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {3}{\ignorespaces Expected distribution of the corrected age of extant taxa from a phylogeny matching our chinchilloid tree in terms of speciation (`lambda'), extinction rate (`mu') and extant sampling fraction (`rho'). `lambda' and `mu' were chosen as the basal extinction and speciation rate values, \emph  {i}.\emph  {e}., before the late Miocene change in extinction regime reported in this study (Figure 5 and Figure~S\ref {fig-EffectSamplingRTT}). Dots (along with errorbars) represent extant chinchilloid species phylogenetic ages (and their 95\% HPD), extracted from the phylogenetic reconstruction used across this study (see Main Text, \emph  {Methods} section).}}{6}{suppfigure.3}\protected@file@percent }
\newlabel{fig-TsPhyloPyRate}{{3}{6}{Expected distribution of the corrected age of extant taxa from a phylogeny matching our chinchilloid tree in terms of speciation (`lambda'), extinction rate (`mu') and extant sampling fraction (`rho'). `lambda' and `mu' were chosen as the basal extinction and speciation rate values, \emph {i}.\emph {e}., before the late Miocene change in extinction regime reported in this study (Figure 5 and Figure~S\ref {fig-EffectSamplingRTT}). Dots (along with errorbars) represent extant chinchilloid species phylogenetic ages (and their 95\% HPD), extracted from the phylogenetic reconstruction used across this study (see Main Text, \emph {Methods} section)}{suppfigure.3}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {4}{\ignorespaces Preservation rate through time in our species-level dataset estimated with PyRate. The solid line represents the mean posterior estimate and the shaded area the associated 95\% HPD interval.}}{7}{suppfigure.4}\protected@file@percent }
\newlabel{fig-preservation_rate}{{4}{7}{Preservation rate through time in our species-level dataset estimated with PyRate. The solid line represents the mean posterior estimate and the shaded area the associated 95\% HPD interval}{suppfigure.4}{}}
\@writefile{lofig}{\contentsline {suppfigure}{\numberline {5}{\ignorespaces Illustration of our occurrence sampling pipeline following a Poisson process with piecewise-constant intensity. The purple line shows the mean posterior preservation rate obtained from our PyRate fossil-only analyses, and the ribbon its 95\% HPD interval. Within each preservation rate bin, the intensity of the occurrence sampling process sas sampled from the posterior distribution of the preservation rate. Black dots represent sampled occurrences, along with their sampling times.}}{7}{suppfigure.5}\protected@file@percent }
\newlabel{fig-sampling_scheme}{{5}{7}{Illustration of our occurrence sampling pipeline following a Poisson process with piecewise-constant intensity. The purple line shows the mean posterior preservation rate obtained from our PyRate fossil-only analyses, and the ribbon its 95\% HPD interval. Within each preservation rate bin, the intensity of the occurrence sampling process sas sampled from the posterior distribution of the preservation rate. Black dots represent sampled occurrences, along with their sampling times}{suppfigure.5}{}}
